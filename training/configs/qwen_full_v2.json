{
  "strategy": "data_only",
  "structural_heads": false,
  "experiment_name": "qwen_full_v2",
  "seed": 42,
  "max_length": 8192,
  "aux_max_length": 2048,
  "epochs": 5,
  "samples_per_epoch": 6000,
  "replay_ratio": 0.2,
  "per_device_batch_size": 2,
  "aux_batch_size": 2,
  "gradient_accumulation_steps": 2,
  "learning_rate_backbone": 0.000005,
  "learning_rate_heads": 0.0003,
  "weight_decay": 0.01,
  "warmup_ratio": 0.1,
  "max_grad_norm": 1.0,
  "backbone_training_mode": "full",
  "num_finetune_layers": 2,
  "bottleneck": 256,
  "dropout": 0.1,
  "num_fusion_layers": 1,
  "num_heads": 8,
  "use_multi_layer_fusion": true,
  "early_layer_ratio": 0.25,
  "middle_layer_ratio": 0.5,
  "attention_implementation": "sdpa",
  "gradient_checkpointing": false,
  "backbone_parameter_dtype": "float32",
  "fused_adamw": true,
  "relation_batch_every": 1,
  "ranking_batch_every": 1,
  "ranking_margin": 0.2,
  "threshold": 0.5,
  "num_workers": 8,
  "gradient_log_every": 10,
  "save_optimizer": false,
  "instruction": "Given a query, judge if the document(code) is related to query.",
  "crf_keep_weight": 0.2,
  "token_ce_weight": 1.0,
  "retention_loss_weight": 0.2,
  "catastrophic_loss_weight": 0.5,
  "max_token_class_weight": 4.0,
  "loss_weights": {"keep": 1.0, "role": 0.0, "relation": 0.0, "rank": 0.0, "document": 0.0}
}
